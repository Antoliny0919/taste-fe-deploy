{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployFrontend",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::chongchong-frontend-poc",
        "arn:aws:s3:::chongchong-frontend-poc/*"
      ]
    },
    {
      "Sid": "InvalidateCache",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "*"
    }
  ]
}
